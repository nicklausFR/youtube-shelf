{
    "manifest_version":  3,
    "name":  "YouTube Channel Shelf",
    "version":  "2.0.0",
    "author":  "nicklausFR",
    "description":  "Organize YouTube channels by category and open videos in a clean interface.",
    "icons":  {
                  "16":  "icons/icon-16.png",
                  "32":  "icons/icon-32.png",
                  "48":  "icons/icon-48.png",
                  "128":  "icons/icon-128.png"
              },
    "action":  {
                   "default_title":  "YouTube Channel Shelf",
                   "default_icon":  {
                                        "16":  "icons/icon-16.png",
                                        "32":  "icons/icon-32.png",
                                        "48":  "icons/icon-48.png",
                                        "128":  "icons/icon-128.png"
                                    }
               },
    "background":  {
                       "service_worker":  "background.js"
                   },
    "side_panel":  {
                       "default_path":  "public/index.html"
                   },
    "permissions":  [
                        "storage",
                        "tabs",
                        "sidePanel",
                        "contextMenus"
                    ],
    "host_permissions":  [
                             "https://www.youtube.com/*",
                             "https://youtube.com/*",
                             "https://i.ytimg.com/*",
                             "https://yt3.ggpht.com/*",
                             "https://yt3.googleusercontent.com/*"
                         ],
    "content_scripts":  [
                            {
                                "matches":  [
                                                "https://www.youtube.com/*",
                                                "https://youtube.com/*"
                                            ],
                                "js":  [
                                           "youtube-pwa.js"
                                       ],
                                "run_at":  "document_idle"
                            },
                            {
                                "matches":  [
                                                "https://www.youtube.com/watch*",
                                                "https://youtube.com/watch*"
                                            ],
                                "css":  [
                                            "youtube-clean.css"
                                        ],
                                "js":  [
                                           "youtube-live.js"
                                       ],
                                "run_at":  "document_idle"
                            }
                        ]
}
